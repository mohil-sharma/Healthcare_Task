# ──────────────────────────────────────────────────
# Healthcare Appointment Platform — Environment vars
# Copy this file to .env and fill in real values.
# ──────────────────────────────────────────────────

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/healthcare

# Auth
JWT_SECRET=changeme_super_secret_key_32chars_min

# Email
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth
GOOGLE_CLIENT_ID=xxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM (e.g. OpenAI / Gemini)
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
